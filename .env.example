# =============================================
# AXIS ABA - Environment Variables
# =============================================
# Copie este arquivo para .env e preencha os valores

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=axis
DATABASE_PASSWORD=
DATABASE_NAME=axis_tcc
DATABASE_MAX_CONNECTIONS=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Tenant padrão (usado apenas pela rota /api/demo)
DEFAULT_TENANT_ID=

# Clerk Auth (obrigatório em prod — gere em https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME
CLERK_WEBHOOK_SECRET=whsec_REPLACE_ME

# Google Calendar Integration (Bible S19 — Bidirecional)
# Mesmas credenciais Google Cloud para TCC e ABA
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://axisclinico.com/api/google/callback
GOOGLE_REDIRECT_URI_ABA=https://axisclinico.com/api/aba/google/callback
GOOGLE_WEBHOOK_URL_ABA=https://axisclinico.com/api/aba/google/webhook
NEXT_PUBLIC_APP_URL=https://axisclinico.com

# OpenAI (Whisper sync em /api/transcribe-audio + Chat Ana TDAH)
OPENAI_API_KEY=sk-REPLACE_ME

# Resend (transactional email — confirmação compra Hotmart, etc.)
RESEND_API_KEY=re_REPLACE_ME
RESEND_FROM=AXIS ABA <noreply@axisclinico.com>
RESEND_FROM_TCC=AXIS TCC <noreply@axisclinico.com>
RESEND_FROM_TDAH=AXIS TDAH <noreply@axisclinico.com>

# Firebase Admin SDK (push notifications — /api/push/send)
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Redis (cache — TTL padrão 5 min)
REDIS_URL=redis://localhost:6379

# Cron Secret (renovação automática de webhooks — 7 dias)
CRON_SECRET=

# Internal API Key (shared-secret server-to-server, usado em /api/push/send)
INTERNAL_API_KEY=

# API URL para cron jobs HTTP (scan_integrity.sh)
AXIS_API_URL=https://axistcc.com

# PostgreSQL Docker (para jobs SQL via docker exec)
POSTGRES_CONTAINER=axis-postgres
POSTGRES_DB=axis
POSTGRES_USER=postgres
# OBRIGATÓRIO em prod e dev local. Gerar via: openssl rand -hex 32
# Compose falha se não estiver setada (sem fallback)
POSTGRES_PASSWORD=REPLACE_ME_WITH_HEX32

# Chave de criptografia (pgcrypto — usada em jobs SQL)
AXIS_ENCRYPTION_KEY=

# Hotmart Webhook (validação de postback)
# Gere em: Hotmart > Configurações > Webhooks > Hottok
# Endpoint: https://axisclinico.com/api/webhook/hotmart
HOTMART_HOTTOK=

# Sentry server/edge (server-only)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=

# Sentry build-time (upload sourcemaps via withSentryConfig)
# Gere SENTRY_AUTH_TOKEN em: https://sentry.io/settings/account/api/auth-tokens/
# SENTRY_ORG/SENTRY_PROJECT sao opcionais (defaults em next.config.ts: psiform/axis-tcc)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Sentry client (browser bundle — prefix obrigatorio)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=

# ASR Service (faster-whisper local — usado pelo worker de transcrição)
ASR_SERVICE_URL=http://localhost:8000/v1/audio/transcriptions
TRANSCRIPT_DIR=/var/lib/axis/transcripts
